---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Button from '@/components/ui/Button.astro';
import { SITE } from '@/config/site';
import { blogPostSchema, breadcrumbSchema, faqSchema } from '@/lib/seo/schema';
import { faqFromBody, formatDate, postPath, readingMinutes, translationsOf, wordCount, type Post } from '@/lib/blog/posts';
import { TOOLS } from '@/lib/tools/registry';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { data } = post;
const lang = data.lang;
const hi = lang === 'hi';
const t = SITE.blog[lang];
const path = postPath(post);
const body = post.body ?? '';
const { Content, headings } = await render(post);
const others = await translationsOf(post);
const tool = data.tool ? TOOLS.find((x) => x.slug === data.tool && x.status === 'live') : undefined;
const toc = headings.filter((h) => h.depth === 2);
const faq = faqFromBody(body);

const schemas = [
  blogPostSchema({ path, title: data.title, description: data.description, lang, date: data.date, updated: data.updated, author: data.author, keywords: data.keywords, wordCount: wordCount(body) }),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: t.title, path: t.path }, { name: data.title, path }]),
  ...(faq.length >= 2 ? [faqSchema(faq)] : []),
];
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  path={path}
  lang={lang}
  type="article"
  article={{ published: data.date, modified: data.updated, author: data.author, tags: data.keywords }}
  alternates={others.map((o) => ({ lang: o.data.lang, path: postPath(o) }))}
  feed={{ title: `${SITE.name} ${t.title}`, path: `${t.path}rss.xml` }}
  crumbs={[{ name: hi ? 'होम' : 'Home', href: '/' }, { name: t.title, href: t.path }, { name: data.title }]}
>
  <JsonLd slot="head" data={schemas} />
  <article class="mx-auto max-w-3xl px-4 py-8 sm:py-12">
    <header>
      <h1 class="text-3xl font-bold leading-tight sm:text-4xl">{data.title}</h1>
      <p class="mt-3 text-sm text-muted">
        <time datetime={data.date.toISOString()}>{formatDate(data.date, lang)}</time> · {data.author} · {readingMinutes(body)} {hi ? 'मिनट पढ़ें' : 'min read'}
      </p>
      {
        others.map((o) => (
          <p class="mt-3 text-sm">
            <a href={postPath(o)} hreflang={o.data.lang} lang={o.data.lang} class="text-link underline-offset-4 hover:underline">
              {o.data.lang === 'hi' ? 'यह पोस्ट हिंदी में पढ़ें' : 'Read this post in English'}
            </a>
          </p>
        ))
      }
    </header>

    {
      toc.length >= 3 && (
        <nav aria-label={hi ? 'इस पोस्ट में' : 'In this post'} class="mt-6 rounded-card border border-border bg-surface p-4 text-sm">
          <p class="font-semibold">{hi ? 'इस पोस्ट में' : 'In this post'}</p>
          <ol class="mt-2 grid gap-1 pl-5 [list-style:decimal]">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="text-link underline-offset-4 hover:underline">
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="post mt-6">
      <Content />
    </div>

    {
      tool && (
        <aside class="mt-10 rounded-card border border-border bg-brand-soft p-5 text-center sm:p-6" aria-label={tool.name}>
          <p class="text-lg font-bold">{hi ? `${tool.name}: अभी आज़माएं` : `Try ${tool.name} now`}</p>
          <p class="mt-1 text-sm text-muted">{hi ? 'फ्री, बिना साइन-अप, और आपकी फाइल आपके डिवाइस से बाहर नहीं जाती।' : `${SITE.tagline} ${SITE.privacyLine}`}</p>
          <div class="mt-4 flex justify-center">
            <Button href={`/${tool.slug}/`} size="lg">
              {hi ? `${tool.name} खोलें` : `Open ${tool.name}`}
            </Button>
          </div>
        </aside>
      )
    }

    <p class="mt-8 text-center text-sm">
      <a href={t.path} class="text-link underline-offset-4 hover:underline">{hi ? '← सभी पोस्ट' : '← All posts'}</a>
    </p>
  </article>
</BaseLayout>
