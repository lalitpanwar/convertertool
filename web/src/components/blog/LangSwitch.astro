---
/** EN | हिं switch for the blog: each side links to the same page in that language (omit a path if it does not exist). */
interface Props {
  current: 'en' | 'hi';
  en?: string;
  hi?: string;
}
const { current, en, hi } = Astro.props;
const items = [
  { code: 'en', label: 'EN', name: 'English', href: en },
  { code: 'hi', label: 'हिं', name: 'हिंदी', href: hi },
] as const;
const base = 'inline-flex min-h-9 min-w-11 items-center justify-center rounded-ctl px-3 text-sm font-semibold transition-colors';
---

<div role="group" aria-label="Language" class="inline-flex rounded-ctl border border-border bg-surface p-0.5 shadow-sm">
  {
    items.map((i) =>
      i.code === current ? (
        <span class={`${base} bg-neutral text-on-neutral`} aria-current="true" lang={i.code} title={i.name}>
          {i.label}
        </span>
      ) : i.href ? (
        <a href={i.href} hreflang={i.code} lang={i.code} title={i.name} class={`${base} text-text hover:bg-surface-2 active:bg-neutral active:text-on-neutral`}>
          {i.label}
        </a>
      ) : (
        <span class={`${base} text-muted opacity-50`} lang={i.code} title={`${i.name}: not available`}>
          {i.label}
        </span>
      ),
    )
  }
</div>
