---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { SITE } from '@/config/site';
import { blogIndexSchema, breadcrumbSchema } from '@/lib/seo/schema';
import { formatDate, postPath, postsFor, readingMinutes } from '@/lib/blog/posts';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = SITE.blog[lang];
const hi = lang === 'hi';
const posts = await postsFor(lang);
const other = SITE.locales.find((l) => l !== lang)!;
const title = `${t.heading} | ${SITE.name}`;
---

<BaseLayout
  title={title}
  description={t.description}
  path={t.path}
  lang={lang}
  alternates={[{ lang: other, path: SITE.blog[other].path }]}
  feed={{ title: `${SITE.name} ${t.title}`, path: `${t.path}rss.xml` }}
  crumbs={[{ name: hi ? 'होम' : 'Home', href: '/' }, { name: t.title }]}
>
  <JsonLd
    slot="head"
    data={[
      blogIndexSchema({ path: t.path, name: t.heading, description: t.description, lang, posts: posts.map((p) => ({ title: p.data.title, path: postPath(p) })) }),
      breadcrumbSchema([{ name: 'Home', path: '/' }, { name: t.title, path: t.path }]),
    ]}
  />
  <div class="mx-auto max-w-3xl px-4 py-10 sm:py-14">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-3xl font-bold leading-tight sm:text-4xl">{t.heading}</h1>
      <a href={SITE.blog[other].path} hreflang={other} lang={other} class="text-sm text-link underline-offset-4 hover:underline">
        {other === 'hi' ? 'हिंदी में पढ़ें' : 'Read in English'}
      </a>
    </div>
    <p class="mt-3 text-muted">{t.description}</p>

    {
      posts.length === 0 ? (
        <p class="mt-10 text-muted">{hi ? 'जल्द ही नई पोस्ट आएंगी।' : 'New posts are coming soon.'}</p>
      ) : (
        <ul class="mt-8 grid gap-4">
          {posts.map((p) => (
            <li>
              <a href={postPath(p)} class="group block rounded-card border border-border bg-surface p-5 transition-shadow hover:border-brand hover:shadow-md">
                <p class="text-xs text-muted">
                  {formatDate(p.data.date, lang)} · {readingMinutes(p.body ?? '')} {hi ? 'मिनट पढ़ें' : 'min read'}
                </p>
                <h2 class="mt-1 text-xl font-bold leading-snug group-hover:text-brand">{p.data.title}</h2>
                <p class="mt-2 text-sm text-muted">{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
