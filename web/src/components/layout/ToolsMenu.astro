---
import { TOOLS } from '@/lib/tools/registry';
import { TOOL_ICONS, fallbackIcon } from '@/lib/tools/icons';
import { SITE } from '@/config/site';

/**
 * The "all tools" menu: a dice-style dot-grid button (top right of the header) that opens a sheet
 * with every tool. Bottom sheet on phones, panel under the button on larger screens.
 * Plain <dialog> + a few lines of script: no framework, no extra JavaScript download.
 */
const live = TOOLS.filter((t) => t.status === 'live');
const soon = TOOLS.filter((t) => t.status !== 'live');
const dots = [5, 12, 19];
---

<button
  type="button"
  id="tools-menu-open"
  class="relative inline-flex h-10 w-10 items-center justify-center rounded-ctl text-text transition-colors hover:bg-surface-2 active:bg-border after:absolute after:-inset-1 after:content-['']"
  aria-label="All PDF tools"
  aria-haspopup="dialog"
  title="All PDF tools"
>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    {dots.flatMap((y) => dots.map((x) => <circle cx={x} cy={y} r="1.9" />))}
  </svg>
</button>

<dialog
  id="tools-menu"
  aria-label="All PDF tools"
  class="tools-sheet m-0 max-h-[85vh] w-full max-w-none overflow-y-auto rounded-t-card border border-border bg-surface p-0 text-text shadow-2xl backdrop:bg-black/40 sm:left-auto sm:right-4 sm:top-[4.25rem] sm:bottom-auto sm:max-h-[calc(100vh-5.5rem)] sm:w-[23rem] sm:rounded-card"
>
  <div class="sticky top-0 z-10 flex items-center justify-between border-b border-border bg-surface px-4 py-3">
    <p class="text-base font-bold">All PDF tools</p>
    <button type="button" data-close class="inline-flex h-9 w-9 items-center justify-center rounded-ctl text-text hover:bg-surface-2 active:bg-border" aria-label="Close menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <div class="p-3">
    <ul class="grid grid-cols-3 gap-2">
      {
        live.map((t) => (
          <li>
            <a href={`/${t.slug}/`} data-close class="flex h-full flex-col items-center gap-2 rounded-card border border-border p-3 text-center transition-colors hover:border-brand hover:bg-brand-soft active:bg-brand-soft">
              <span class="flex h-11 w-11 items-center justify-center rounded-card bg-brand-soft text-brand">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={TOOL_ICONS[t.slug] ?? fallbackIcon} /></svg>
              </span>
              <span class="text-xs font-semibold leading-tight">{t.name}</span>
            </a>
          </li>
        ))
      }
      {
        soon.map((t) => (
          <li>
            <div class="flex h-full flex-col items-center gap-2 rounded-card border border-dashed border-border p-3 text-center opacity-60" aria-disabled="true">
              <span class="flex h-11 w-11 items-center justify-center rounded-card bg-surface-2 text-muted">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={TOOL_ICONS[t.slug] ?? fallbackIcon} /></svg>
              </span>
              <span class="text-xs font-semibold leading-tight">{t.name}</span>
              <span class="text-[10px] font-medium uppercase tracking-wide text-muted">Soon</span>
            </div>
          </li>
        ))
      }
    </ul>

    <ul class="mt-3 grid gap-1 border-t border-border pt-3 text-sm">
      <li><a href="/blog/" data-close class="flex min-h-10 items-center rounded-ctl px-2 font-medium hover:bg-surface-2 active:bg-border">Blog</a></li>
      <li><a href="/hi/blog/" data-close hreflang="hi" lang="hi" class="flex min-h-10 items-center rounded-ctl px-2 font-medium hover:bg-surface-2 active:bg-border">ब्लॉग (हिंदी)</a></li>
      <li><a href="/security/" data-close class="flex min-h-10 items-center rounded-ctl px-2 text-muted hover:bg-surface-2 active:bg-border">{SITE.privacyLine} How it works</a></li>
    </ul>
  </div>
</dialog>

<script is:inline>
  (function () {
    var open = document.getElementById('tools-menu-open');
    var dlg = document.getElementById('tools-menu');
    if (!open || !dlg || typeof dlg.showModal !== 'function') return;
    open.addEventListener('click', function () {
      dlg.showModal();
    });
    dlg.addEventListener('click', function (e) {
      var t = e.target;
      // a click on the dark area around the sheet, or on a close button / a link in the sheet
      if (t === dlg || (t.closest && t.closest('[data-close]'))) dlg.close();
    });
  })();
</script>
