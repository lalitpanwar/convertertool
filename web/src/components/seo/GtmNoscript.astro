---
import { SITE } from '@/config/site';

/** Google Tag Manager fallback for visitors without JavaScript (right after <body>). */
const id = SITE.analytics.gtmId;
const valid = /^GTM-[A-Z0-9]+$/.test(id);
---

{valid && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${id}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
