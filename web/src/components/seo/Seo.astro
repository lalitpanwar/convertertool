---
import { SITE, absUrl } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  /** path starting with "/", used for canonical */
  path: string;
  noindex?: boolean;
  /** share image path in /public (defaults to SITE.ogImage) */
  image?: string;
  imageAlt?: string;
  /** 'website' (default) or 'article' */
  type?: string;
  /** page language (default: site default) */
  lang?: string;
  /** the same page in other languages (hreflang) */
  alternates?: { lang: string; path: string }[];
  /** article pages: publish/modify time, author, keywords */
  article?: { published: Date; modified?: Date; author: string; tags?: string[] };
  /** RSS feed of this section (blog) */
  feed?: { title: string; path: string };
}
const { title, description = SITE.defaultDescription, path, noindex = false, image = SITE.ogImage, imageAlt = SITE.ogImageAlt, type = 'website', lang = SITE.defaultLocale, alternates = [], article, feed } = Astro.props;
const xDefault = alternates.find((a) => a.lang === SITE.defaultLocale)?.path;
const canonical = absUrl(path);
const img = absUrl(image);
const index = SITE.robots.allowIndexing && !noindex;
const { google, bing } = SITE.verification;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={index ? 'index,follow,max-image-preview:large,max-snippet:-1' : 'noindex,follow'} />
<meta name="theme-color" content={SITE.themeColor} />
<meta name="application-name" content={SITE.name} />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="alternate" hreflang={lang} href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={absUrl(a.path)} />)}
<link rel="alternate" hreflang="x-default" href={xDefault ? absUrl(xDefault) : canonical} />
{feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.path} />}
{google && <meta name="google-site-verification" content={google} />}
{bing && <meta name="msvalidate.01" content={bing} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.ogLocale[lang] ?? SITE.ogLocale[SITE.defaultLocale]} />
{alternates.map((a) => <meta property="og:locale:alternate" content={SITE.ogLocale[a.lang]} />)}
{article && <meta property="article:published_time" content={article.published.toISOString()} />}
{article && <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />}
{article && <meta property="article:author" content={article.author} />}
{article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
{article && <meta name="author" content={article.author} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={img} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={img} />
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}
