---
import type { Faq } from '@/lib/tools/types';
interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
---

<section aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-xl font-semibold">Frequently asked questions</h2>
  <div class="mt-4 grid gap-2">
    {faqs.map((f) => (
      <details class="group rounded-card border border-border bg-surface px-4">
        <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 py-2 font-medium">
          {f.q}
          <span aria-hidden="true" class="text-muted transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="pb-4 text-sm text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</section>
