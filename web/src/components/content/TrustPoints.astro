---
/** A short list of promises with green checks (privacy summary). */
interface Props {
  points: { title: string; text: string }[];
}
const { points } = Astro.props;
---

<ul class="grid gap-3 sm:grid-cols-2">
  {
    points.map((p) => (
      <li class="flex gap-3 rounded-card border border-success/30 bg-success-soft p-4">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-success text-white" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </span>
        <span>
          <span class="block font-semibold">{p.title}</span>
          <span class="mt-0.5 block text-sm text-muted">{p.text}</span>
        </span>
      </li>
    ))
  }
</ul>
