---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCard from '@/components/content/ToolCard.astro';
import Button from '@/components/ui/Button.astro';
import { liveTools } from '@/lib/tools/registry';
---

<BaseLayout title="Page not found" description="This page does not exist. Pick a PDF tool below." path="/404/" noindex>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-20">
    <div class="mx-auto max-w-xl text-center">
      <p class="text-5xl font-bold text-brand sm:text-6xl">404</p>
      <h1 class="mt-3 text-2xl font-bold sm:text-3xl">We could not find this page</h1>
      <p class="mt-3 text-muted">The link may be old or mistyped. Go back home or pick one of the tools below.</p>
      <div class="mt-6 flex justify-center">
        <Button href="/" size="lg">Go to home page</Button>
      </div>
    </div>

    <section class="mt-12" aria-label="PDF tools">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {liveTools().map((t) => <ToolCard tool={t} />)}
      </div>
    </section>
  </div>
</BaseLayout>
