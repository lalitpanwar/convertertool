---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCard from '@/components/content/ToolCard.astro';
import { TOOLS } from '@/lib/tools/registry';
import JsonLd from '@/components/seo/JsonLd.astro';
import { liveTools } from '@/lib/tools/registry';
import { toolListSchema, webPageSchema } from '@/lib/seo/schema';
import TrustPoints from '@/components/content/TrustPoints.astro';
import { SITE } from '@/config/site';

const title = `${SITE.name}: Free PDF Tools, Fast and Private`;
const description = SITE.defaultDescription;
---

<BaseLayout
  title={title}
  description={description}
  path="/"
>
  <JsonLd slot="head" data={[webPageSchema({ path: '/', name: title, description, type: 'CollectionPage' }), toolListSchema(liveTools())]} />
  <div class="mx-auto max-w-6xl px-4 py-10 sm:py-16">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl font-bold leading-tight sm:text-5xl">Fix your PDF problem in seconds</h1>
      <p class="mt-4 text-lg text-muted">{SITE.tagline} {SITE.privacyLine}</p>
    </div>

    <section id="tools" class="mt-10 sm:mt-14" aria-label="PDF tools">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {TOOLS.map((t) => <ToolCard tool={t} />)}
      </div>
    </section>

    <section class="mt-12" aria-label="Privacy">
      <h2 class="text-center text-2xl font-bold">Your files stay yours</h2>
      <div class="mt-5">
        <TrustPoints
          points={[
            { title: 'Never uploaded', text: 'Every tool runs inside your browser, on your own device.' },
            { title: 'Not stored, not shared', text: 'We do not keep your files and we do not share them with anyone.' },
            { title: 'No sign-up', text: 'No account, email or phone number needed.' },
            { title: 'You can check it', text: 'See in one minute that nothing is uploaded.' },
          ]}
        />
      </div>
      <p class="mt-4 text-center text-sm">
        <a href="/security/" class="text-link underline-offset-4 hover:underline">How your files stay private</a> ·
        <a href="/privacy/" class="text-link underline-offset-4 hover:underline">Privacy Policy</a>
      </p>
    </section>
  </div>
</BaseLayout>
