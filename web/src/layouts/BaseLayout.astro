---
import '@/styles/global.css';
import Seo from '@/components/seo/Seo.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Gtm from '@/components/seo/Gtm.astro';
import GtmNoscript from '@/components/seo/GtmNoscript.astro';
import { organizationSchema, websiteSchema } from '@/lib/seo/schema';
import { SITE } from '@/config/site';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs, { type Crumb } from '@/components/layout/Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  path: string;
  noindex?: boolean;
  lang?: string;
  type?: string;
  alternates?: { lang: string; path: string }[];
  article?: { published: Date; modified?: Date; author: string; tags?: string[] };
  feed?: { title: string; path: string };
  /** shown at the bottom as "You are here"; defaults to just Home */
  crumbs?: Crumb[];
}
const { title, description, path, noindex, lang = SITE.defaultLocale, type, alternates, article, feed, crumbs = [{ name: 'Home' }] } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} path={path} noindex={noindex} lang={lang} type={type} alternates={alternates} article={article} feed={feed} />
    <JsonLd data={[organizationSchema(), websiteSchema()]} />
    <Gtm />
    <slot name="head" />
  </head>
  <body>
    <GtmNoscript />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:rounded-ctl focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Breadcrumbs crumbs={crumbs} />
    <script is:inline>
      // iOS Safari only shows :active (pressed) styles when a touch listener exists
      document.addEventListener('touchstart', function () {}, { passive: true });
    </script>
    <Footer />
  </body>
</html>
