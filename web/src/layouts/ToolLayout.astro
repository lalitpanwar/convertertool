---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Steps from '@/components/content/Steps.astro';
import Faq from '@/components/content/Faq.astro';
import Guide from '@/components/content/Guide.astro';
import RelatedTools from '@/components/content/RelatedTools.astro';
import ToolIsland from '@/components/tool/ToolIsland.astro';
import { relatedTools } from '@/lib/tools/registry';
import { SITE } from '@/config/site';
import { toolSchemas } from '@/lib/seo/schema';
import type { ToolDef } from '@/lib/tools/types';

interface Props {
  tool: ToolDef;
}
const { tool } = Astro.props;
const path = `/${tool.slug}`;

const schema = toolSchemas(tool);
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  path={path}
  crumbs={[{ name: 'Home', href: '/' }, { name: tool.name }]}
>
  <JsonLd slot="head" data={schema} />
  <div class="w-full px-4 py-6 sm:px-6 sm:py-10">

    <h1 class="text-center text-3xl font-bold leading-tight sm:text-4xl">{tool.h1}</h1>
    <p class="mx-auto mt-3 max-w-2xl text-center text-muted">{tool.intro}</p>

    <section class="mt-8 rounded-card border border-border bg-surface p-4 shadow-sm sm:p-6" aria-label={tool.name}>
      {tool.island && <ToolIsland island={tool.island} noun={tool.fileNoun} draftKey={tool.slug} />}
    </section>
    <p class="mt-3 text-center text-sm text-muted">{SITE.privacyLine}</p>

    <div class="mx-auto mt-12 grid max-w-6xl gap-12">
      <Steps steps={tool.steps} />
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        {tool.guide && <Guide sections={tool.guide} />}
        <Faq faqs={tool.faqs} />
      </div>
      <RelatedTools tools={relatedTools(tool)} />
    </div>
  </div>
</BaseLayout>
